// Janela da sessão no controlador (`12-levantamento-ux.md` §5.3 e §5.6): etapas de conexão,
// barra com abas dos monitores e teclado, vídeo do monitor ativo e o cursor do host desenhado
// por cima (cursor separado, `07-protocolo.md`), o indicador de qualidade da conexão com o seletor
// de codec e taxa (`14-selecao-adaptativa.md` §7.3) e o painel de diagnóstico do vídeo e da rede.
import { LineEdit, CheckBox } from "std-widgets.slint";
import { Tema } from "tema.slint";
import { Botao, Toast, MensagemChat, PainelChat, DicaTelaCheia } from "componentes.slint";
import { ArquivosNaSessao } from "arquivos.slint";

export struct AbaMonitor {
    texto: string,
    ativa: bool,
    // `false`: o host não liberou este monitor (Wayland).
    liberada: bool,
    // Aberto numa janela própria (clicar traz de volta).
    destacada: bool,
}

// Uma linha do painel de diagnóstico; `titulo` = cabeçalho de seção (sem valor).
export struct LinhaDiag {
    rotulo: string,
    valor: string,
    titulo: bool,
}

// Nível das barras do indicador de qualidade.
export enum NivelQualidade { medindo, ruim, regular, boa, excelente }

// Um codec no seletor da sessão. `disponivel = false`: algum dos lados não tem (o `motivo` diz
// qual).
export struct OpcaoCodec {
    nome: string,
    disponivel: bool,
    motivo: string,
}

export global CoresQualidade {
    pure public function cor(n: NivelQualidade) -> color {
        if n == NivelQualidade.excelente || n == NivelQualidade.boa { return Tema.online; }
        if n == NivelQualidade.regular { return Tema.relay; }
        if n == NivelQualidade.ruim { return #e5534b; }
        return Tema.offline;
    }
    pure public function barras(n: NivelQualidade) -> int {
        if n == NivelQualidade.excelente { return 4; }
        if n == NivelQualidade.boa { return 3; }
        if n == NivelQualidade.regular { return 2; }
        if n == NivelQualidade.ruim { return 1; }
        return 0;
    }
    pure public function texto(n: NivelQualidade) -> string {
        if n == NivelQualidade.excelente { return @tr("Conexão excelente"); }
        if n == NivelQualidade.boa { return @tr("Conexão boa"); }
        if n == NivelQualidade.regular { return @tr("Conexão regular"); }
        if n == NivelQualidade.ruim { return @tr("Conexão ruim"); }
        return @tr("Medindo a conexão");
    }
}

// Quatro barras de sinal, coloridas pelo nível.
component Barras inherits HorizontalLayout {
    in property <NivelQualidade> nivel;
    in property <length> escala: 1px;
    in property <color> vazia: Tema.offline.with-alpha(0.45);
    property <int> cheias: CoresQualidade.barras(nivel);
    property <color> cor: CoresQualidade.cor(nivel);
    spacing: 2 * escala;
    alignment: center;
    for i in 4: VerticalLayout {
        alignment: end;
        Rectangle {
            width: 3 * root.escala;
            height: (4 + 3 * i) * root.escala;
            border-radius: 1 * root.escala;
            background: i < root.cheias ? root.cor : root.vazia;
        }
    }
}

// Indicador da barra da sessão: barras + "12 ms · direto · LAN". Clicar abre o painel.
component IndicadorQualidade inherits Rectangle {
    in property <NivelQualidade> nivel;
    in property <string> resumo;
    in property <bool> aberto;
    callback clicado();
    accessible-role: button;
    accessible-label: CoresQualidade.texto(nivel) + ", " + resumo;
    accessible-action-default => { clicado(); }
    horizontal-stretch: 0;
    height: 32px;
    border-radius: Tema.raio;
    background: aberto ? Tema.superficie-2 : toque.has-hover ? Tema.superficie-2.with-alpha(0.6) : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Barras { nivel: root.nivel; }
        }
        Text {
            text: root.resumo;
            font-size: Tema.fonte-pequena;
            color: Tema.texto-2;
            vertical-alignment: center;
        }
    }
    toque := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicado(); }
    }
}

// Botão pequeno de escolha (codec, taxa), no painel escuro.
component Chip inherits Rectangle {
    in property <string> texto;
    in property <bool> ativo;
    in property <bool> habilitado: true;
    callback clicado();
    accessible-role: button;
    accessible-label: texto;
    accessible-checked: ativo;
    accessible-enabled: habilitado;
    accessible-action-default => { if habilitado { clicado(); } }
    min-width: rotulo.preferred-width + 20px;
    height: 28px;
    border-radius: 14px;
    border-width: 1px;
    border-color: ativo ? Tema.primaria : #ffffff30;
    background: ativo ? Tema.primaria : toque.has-hover && habilitado ? #ffffff1a : transparent;
    rotulo := Text {
        width: parent.width;
        height: parent.height;
        horizontal-alignment: center;
        vertical-alignment: center;
        text: root.texto;
        font-size: Tema.fonte-pequena;
        font-weight: root.ativo ? 600 : 400;
        color: !root.habilitado ? #ffffff4d : root.ativo ? #ffffff : #e9ebef;
        font-italic: !root.habilitado;
    }
    toque := TouchArea {
        mouse-cursor: root.habilitado ? pointer : default;
        clicked => { if root.habilitado { root.clicado(); } }
    }
}

// Linha rótulo/valor do painel escuro.
component LinhaEscura inherits HorizontalLayout {
    in property <string> rotulo;
    in property <string> valor;
    spacing: 8px;
    Text {
        text: root.rotulo;
        width: 120px;
        font-size: Tema.fonte-pequena;
        color: #9aa4b2;
    }
    Text {
        horizontal-stretch: 1;
        text: root.valor;
        font-size: Tema.fonte-pequena;
        color: #e9ebef;
        wrap: word-wrap;
    }
}

// Painel que abre ao clicar no indicador: o porquê do nível, os números e o seletor de codec e
// de taxa desta sessão.
component PainelQualidade inherits Rectangle {
    in property <NivelQualidade> nivel;
    in property <string> frase;
    in property <[LinhaDiag]> linhas;
    in property <[OpcaoCodec]> codecs;
    // Os codecs que não dá para usar, e por quê ("PyroWave: yurisp não codifica").
    in property <string> aviso-codecs;
    in property <int> codec;
    in property <[string]> taxas;
    in property <int> taxa;
    callback codec-mudou(int);
    callback taxa-mudou(int);
    callback diagnostico();
    callback fechar();

    width: 420px;
    border-radius: Tema.raio-grande;
    background: #0d1117f0;
    drop-shadow-blur: 16px;
    drop-shadow-color: #00000080;
    // Clique no painel não chega ao vídeo.
    TouchArea { }
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            Barras { nivel: root.nivel; escala: 1.6px; vazia: #ffffff38; }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                Text {
                    text: CoresQualidade.texto(root.nivel);
                    font-size: 15px;
                    font-weight: 700;
                    color: #ffffff;
                }
                Text {
                    text: root.frase;
                    font-size: Tema.fonte-pequena;
                    color: #c5ccd6;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 24px;
                    height: 24px;
                    border-radius: 12px;
                    background: fechar-toque.has-hover ? #ffffff1a : transparent;
                    accessible-role: button;
                    accessible-label: @tr("Fechar");
                    accessible-action-default => { root.fechar(); }
                    Text { text: "✕"; color: #9aa4b2; font-size: 12px; }
                    fechar-toque := TouchArea { mouse-cursor: pointer; clicked => { root.fechar(); } }
                }
            }
        }
        VerticalLayout {
            spacing: 4px;
            for l in root.linhas: LinhaEscura { rotulo: l.rotulo; valor: l.valor; }
        }
        Rectangle { height: 1px; background: #ffffff1f; }
        Text { text: @tr("Vídeo desta sessão"); font-size: Tema.fonte-pequena; font-weight: 700; color: #ffffff; }
        Text { text: @tr("Codec"); font-size: Tema.fonte-pequena; color: #9aa4b2; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for c[i] in root.codecs: Chip {
                texto: c.nome;
                ativo: i == root.codec;
                habilitado: c.disponivel;
                clicado => { root.codec-mudou(i); }
            }
        }
        if root.aviso-codecs != "": Text {
            text: root.aviso-codecs;
            font-size: 11px;
            color: #8b95a3;
            wrap: word-wrap;
        }
        Text { text: @tr("Taxa de bits (Mbit/s)"); font-size: Tema.fonte-pequena; color: #9aa4b2; }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            for t[i] in root.taxas: Chip {
                texto: t;
                ativo: i == root.taxa;
                clicado => { root.taxa-mudou(i); }
            }
        }
        Text {
            text: @tr("Automático escolhe pelo que as duas máquinas têm e pela rede. A escolha vale só para esta sessão; o padrão fica em Configurações → Sessão.");
            font-size: 11px;
            color: #8b95a3;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            Rectangle {
                width: rotulo-diag.preferred-width + 20px;
                height: 28px;
                border-radius: Tema.raio;
                background: diag-toque.has-hover ? #ffffff1a : transparent;
                accessible-role: button;
                accessible-label: rotulo-diag.text;
                accessible-action-default => { root.diagnostico(); }
                rotulo-diag := Text { text: @tr("Diagnóstico completo"); color: #7aa2ff; font-size: Tema.fonte-pequena; font-weight: 600; }
                diag-toque := TouchArea { mouse-cursor: pointer; clicked => { root.diagnostico(); } }
            }
        }
    }
}

component PainelDiagnostico inherits Rectangle {
    in property <[LinhaDiag]> linhas;
    width: 380px;
    height: lista.preferred-height + 24px;
    border-radius: Tema.raio;
    background: #0d1117e0;
    lista := VerticalLayout {
        x: 12px;
        y: 12px;
        width: parent.width - 24px;
        spacing: 3px;
        for l in root.linhas: HorizontalLayout {
            padding-top: l.titulo ? 6px : 0px;
            spacing: 8px;
            Text {
                text: l.rotulo;
                width: l.titulo ? 356px : 128px;
                font-size: Tema.fonte-pequena;
                font-weight: l.titulo ? 700 : 400;
                color: l.titulo ? #ffffff : #9aa4b2;
                overflow: elide;
            }
            if !l.titulo: Text {
                text: l.valor;
                font-size: Tema.fonte-pequena;
                color: #e9ebef;
                wrap: word-wrap;
            }
        }
    }
}

// "Acesso com senha" enquanto espera alguém aceitar (ou depois de uma senha errada).
component CaixaSenha inherits Rectangle {
    in property <string> host;
    in property <string> erro;
    callback entrar(string, bool);
    width: 420px;
    height: coluna.preferred-height;
    background: Tema.superficie;
    border-radius: Tema.raio;
    coluna := VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Text {
            text: @tr("Tem a senha de {}? Entre sem esperar alguém aceitar lá.", root.host);
            color: Tema.texto;
            font-size: Tema.fonte;
            wrap: word-wrap;
        }
        if root.erro != "": Text {
            text: root.erro;
            color: Tema.perigo;
            font-size: Tema.fonte-pequena;
            wrap: word-wrap;
        }
        campo := LineEdit {
            input-type: password;
            placeholder-text: @tr("Senha de acesso");
            accepted => { root.entrar(campo.text, salvar.checked); }
        }
        salvar := CheckBox {
            text: @tr("Salvar a senha neste computador");
            checked: true;
        }
        HorizontalLayout {
            alignment: end;
            Botao {
                texto: @tr("Entrar com senha");
                primario: true;
                habilitado: campo.text != "";
                clicado => { root.entrar(campo.text, salvar.checked); }
            }
        }
    }
}

export component JanelaSessao inherits Window {
    in property <string> host;
    // "Encontrando desktop-casa…", "Esperando desktop-casa aceitar…" ou o motivo do fim.
    in property <string> etapa;
    in property <bool> ao-vivo;
    in property <bool> terminou;
    // Mostra o campo de senha (o host aceita senha e ainda não está ao vivo).
    in property <bool> pede-senha;
    in property <string> erro-senha;
    in property <image> quadro;
    in property <bool> tem-video;
    in property <[AbaMonitor]> abas;
    // "ABNT2 → US-Intl"
    in property <string> teclado;
    in-out property <string> toast;
    // Cursor do host, em pixels da área de vídeo.
    in property <image> cursor;
    in property <bool> cursor-visivel;
    in property <length> cursor-x;
    in property <length> cursor-y;
    // Painel de diagnóstico (botão "Diagnóstico" na barra).
    in-out property <bool> diagnostico-aberto: false;
    in property <[LinhaDiag]> diagnostico;
    // Indicador de qualidade e painel com o seletor de codec e de taxa.
    in property <NivelQualidade> qualidade: NivelQualidade.medindo;
    in property <string> qualidade-resumo: @tr("Medindo…");
    in property <string> qualidade-frase;
    in property <[LinhaDiag]> qualidade-linhas;
    in-out property <bool> qualidade-aberta: false;
    in property <[OpcaoCodec]> codecs;
    in property <string> aviso-codecs;
    in-out property <int> codec-escolhido: 0;
    in property <[string]> taxas;
    in-out property <int> taxa-escolhida: 0;
    // Tamanho da área de vídeo (para o app converter o mouse).
    out property <length> area-largura: video.width;
    out property <length> area-altura: video.height;

    // Som do computador remoto (`15-audio.md` §8): o botão só aparece se o host permite.
    in property <bool> som-permitido;
    in-out property <bool> som-ligado: true;
    callback som-mudou(bool);
    // Ctrl+Alt+Del no host (tela de entrada, bloqueio, UAC): só com controle e host que atende.
    in property <bool> atencao-segura;
    callback ctrl-alt-del();

    // Chat da sessão (item pós-MVP): o painel abre pela barra.
    in property <[MensagemChat]> chat;
    in-out property <bool> chat-aberto: false;
    // Mensagens recebidas com o painel fechado (badge no botão); zera ao abrir.
    in-out property <int> chat-nao-lidas: 0;
    callback enviar-chat(string);
    // O campo do chat ganhou ou perdeu o foco (o app solta o teclado do remoto enquanto isso).
    callback chat-digitando(bool);
    // Tela cheia (botão na barra ou Ctrl+Alt+F). Quem muda é o app: a barra some, fica uma
    // alça no topo com "Sair da tela cheia" e um aviso de como sair por alguns segundos.
    in property <bool> tela-cheia: false;
    in-out property <bool> dica-tela-cheia: false;
    callback mudar-tela-cheia(bool);
    // "Usar todos os meus monitores" (`13-multimonitor.md` §2.2): cada monitor do host em tela
    // cheia num monitor local. Sair da tela cheia em qualquer janela sai do modo.
    in property <bool> todos-monitores: false;
    callback usar-todos-monitores();
    // "Seguir o mouse": a aba acompanha o cursor do host entre os monitores.
    in-out property <bool> seguir-mouse: false;
    callback seguir-mouse-mudou(bool);

    callback desconectar();
    callback entrar-com-senha(string, bool);
    callback trocar-aba(int);
    // "Abrir em janela" (`13-multimonitor.md` §2.2).
    callback destacar-aba(int);
    callback mouse-moveu(length, length);
    callback mouse-botao(PointerEventButton, bool, length, length);
    callback mouse-rolou(length, length);
    callback codec-mudou(int);
    callback taxa-mudou(int);

    title: root.host + " · TailDesk";
    icon: @image-url("icones/taildesk-64.png");
    preferred-width: 1280px;
    preferred-height: 760px;
    background: black;

    VerticalLayout {
        if !root.tela-cheia: Rectangle {
            height: 40px;
            background: Tema.superficie;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                Text {
                    text: root.host;
                    font-weight: 700;
                    font-size: Tema.fonte;
                    color: Tema.texto;
                    vertical-alignment: center;
                }
                for aba[i] in root.abas: Rectangle {
                    width: linha.preferred-width + 20px;
                    border-radius: Tema.raio;
                    background: aba.ativa ? Tema.superficie-2 : transparent;
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.trocar-aba(i); }
                    }
                    linha := HorizontalLayout {
                        x: 10px;
                        spacing: 6px;
                        Text {
                            text: aba.texto;
                            font-size: Tema.fonte-pequena;
                            color: aba.liberada ? Tema.texto : Tema.offline;
                            font-italic: !aba.liberada || aba.destacada;
                            vertical-alignment: center;
                        }
                        // Abrir em janela própria; num destacado, só marca onde ele está.
                        if aba.liberada: Text {
                            text: "⧉";
                            font-size: Tema.fonte-pequena;
                            color: aba.destacada ? Tema.online : Tema.texto-2;
                            vertical-alignment: center;
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    if !aba.destacada { root.destacar-aba(i); } else { root.trocar-aba(i); }
                                }
                            }
                        }
                    }
                }
                Rectangle { }
                Text {
                    text: root.teclado;
                    font-size: Tema.fonte-pequena;
                    color: Tema.texto-2;
                    vertical-alignment: center;
                }
                if root.ao-vivo && root.atencao-segura: Botao {
                    y: 4px;
                    altura: 32px;
                    texto: "Ctrl+Alt+Del";
                    discreto: true;
                    clicado => { root.ctrl-alt-del(); }
                }
                if root.ao-vivo && root.som-permitido: Botao {
                    y: 4px;
                    altura: 32px;
                    texto: root.som-ligado ? @tr("🔊 Som") : @tr("🔇 Som");
                    discreto: !root.som-ligado;
                    clicado => {
                        root.som-ligado = !root.som-ligado;
                        root.som-mudou(root.som-ligado);
                    }
                }
                if root.ao-vivo: IndicadorQualidade {
                    y: 4px;
                    nivel: root.qualidade;
                    resumo: root.qualidade-resumo;
                    aberto: root.qualidade-aberta;
                    clicado => {
                        root.qualidade-aberta = !root.qualidade-aberta;
                        root.diagnostico-aberto = false;
                    }
                }
                if root.ao-vivo: Botao {
                    y: 4px;
                    altura: 32px;
                    texto: @tr("Diagnóstico");
                    discreto: !root.diagnostico-aberto;
                    clicado => {
                        root.diagnostico-aberto = !root.diagnostico-aberto;
                        root.qualidade-aberta = false;
                    }
                }
                if root.ao-vivo: Botao {
                    y: 4px;
                    altura: 32px;
                    texto: root.chat-nao-lidas > 0 ? @tr("💬 Chat ({})", root.chat-nao-lidas) : @tr("💬 Chat");
                    discreto: !root.chat-aberto;
                    clicado => {
                        root.chat-aberto = !root.chat-aberto;
                        root.qualidade-aberta = false;
                        root.diagnostico-aberto = false;
                        if root.chat-aberto { root.chat-nao-lidas = 0; }
                    }
                }
                if root.ao-vivo && root.abas.length >= 2: Botao {
                    y: 4px;
                    altura: 32px;
                    texto: @tr("🖱 Seguir o mouse");
                    discreto: !root.seguir-mouse;
                    clicado => {
                        root.seguir-mouse = !root.seguir-mouse;
                        root.seguir-mouse-mudou(root.seguir-mouse);
                    }
                }
                if root.ao-vivo && root.abas.length >= 2: Botao {
                    y: 4px;
                    altura: 32px;
                    texto: @tr("🖥 Todos os monitores");
                    discreto: true;
                    clicado => { root.usar-todos-monitores(); }
                }
                Botao {
                    y: 4px;
                    altura: 32px;
                    texto: @tr("⛶ Tela cheia");
                    discreto: true;
                    clicado => { root.mudar-tela-cheia(true); }
                }
                Botao {
                    y: 4px;
                    altura: 32px;
                    texto: root.terminou ? @tr("Fechar") : root.ao-vivo ? @tr("Desconectar") : @tr("Cancelar");
                    perigo: !root.terminou;
                    discreto: true;
                    clicado => { root.desconectar(); }
                }
            }
        }
        video := Rectangle {
            background: black;
            // Clicar no vídeo tira o foco do campo do chat: o teclado volta para o remoto.
            foco-video := FocusScope {
                width: 0;
                height: 0;
            }
            Image {
                width: 100%;
                height: 100%;
                source: root.quadro;
                image-fit: contain;
                visible: root.tem-video;
            }
            if root.cursor-visivel && root.ao-vivo: Image {
                x: root.cursor-x;
                y: root.cursor-y;
                source: root.cursor;
            }
            // Escondido no vídeo: quem aparece é o cursor do host.
            toque := TouchArea {
                mouse-cursor: root.ao-vivo ? MouseCursor.none : MouseCursor.default;
                moved => { root.mouse-moveu(self.mouse-x, self.mouse-y); }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        foco-video.focus();
                        root.mouse-botao(e.button, true, self.mouse-x, self.mouse-y);
                    } else if e.kind == PointerEventKind.up {
                        root.mouse-botao(e.button, false, self.mouse-x, self.mouse-y);
                    } else if e.kind == PointerEventKind.move && !self.pressed {
                        root.mouse-moveu(self.mouse-x, self.mouse-y);
                    }
                }
                scroll-event(e) => {
                    root.mouse-rolou(e.delta-x, e.delta-y);
                    accept
                }
            }
            // Sessão encerrada: o último quadro fica bem escuro por baixo do aviso, para não
            // parecer que o vídeo só congelou.
            if root.terminou && root.tem-video: Rectangle {
                background: #000000d9;
            }
            if !root.ao-vivo || !root.tem-video: VerticalLayout {
                alignment: center;
                spacing: 10px;
                padding: 24px;
                if root.terminou: Text {
                    text: @tr("Sessão encerrada");
                    color: #ffffff;
                    font-size: 26px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                Text {
                    text: root.ao-vivo ? @tr("Esperando o vídeo do monitor…") : root.etapa;
                    color: #e9ebef;
                    font-size: 18px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                if root.pede-senha && !root.ao-vivo: HorizontalLayout {
                    alignment: center;
                    CaixaSenha {
                        host: root.host;
                        erro: root.erro-senha;
                        entrar(senha, salvar) => { root.entrar-com-senha(senha, salvar); }
                    }
                }
            }
            if root.diagnostico-aberto && root.ao-vivo: PainelDiagnostico {
                linhas: root.diagnostico;
                x: parent.width - self.width - 12px;
                y: 12px;
            }
            if root.qualidade-aberta && root.ao-vivo: PainelQualidade {
                x: parent.width - self.width - 12px;
                y: 12px;
                height: self.preferred-height;
                aviso-codecs: root.aviso-codecs;
                nivel: root.qualidade;
                frase: root.qualidade-frase;
                linhas: root.qualidade-linhas;
                codecs: root.codecs;
                codec: root.codec-escolhido;
                taxas: root.taxas;
                taxa: root.taxa-escolhida;
                codec-mudou(i) => {
                    root.codec-escolhido = i;
                    root.codec-mudou(i);
                }
                taxa-mudou(i) => {
                    root.taxa-escolhida = i;
                    root.taxa-mudou(i);
                }
                diagnostico => {
                    root.qualidade-aberta = false;
                    root.diagnostico-aberto = true;
                }
                fechar => { root.qualidade-aberta = false; }
            }
            if root.chat-aberto && root.ao-vivo: PainelChat {
                x: parent.width - self.width - 12px;
                y: root.tela-cheia ? 60px : 12px;
                height: self.preferred-height;
                mensagens: root.chat;
                enviar(t) => { root.enviar-chat(t); }
                fechar => { root.chat-aberto = false; }
                digitando-mudou(v) => { root.chat-digitando(v); }
            }
            if root.toast != "": Toast {
                texto: root.toast;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 24px;
            }
            // Em tela cheia: alça sempre visível no topo, com o atalho escrito e o botão de sair
            // (e o chat, que fica sem a barra).
            if root.tela-cheia: Rectangle {
                x: (parent.width - self.width) / 2;
                y: 8px;
                width: alca.preferred-width;
                height: 44px;
                border-radius: 22px;
                background: Tema.superficie;
                drop-shadow-blur: 12px;
                drop-shadow-color: #00000080;
                // O cursor do sistema volta aqui (no vídeo ele fica escondido).
                TouchArea { mouse-cursor: MouseCursor.default; }
                alca := HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 6px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 8px;
                    Text {
                        text: root.host + " · " + @tr("Ctrl+Alt+F sai da tela cheia");
                        color: Tema.texto;
                        font-size: Tema.fonte-pequena;
                        vertical-alignment: center;
                    }
                    if root.ao-vivo: Botao {
                        altura: 32px;
                        texto: root.chat-nao-lidas > 0 ? @tr("💬 Chat ({})", root.chat-nao-lidas) : @tr("💬 Chat");
                        discreto: !root.chat-aberto;
                        clicado => {
                            root.chat-aberto = !root.chat-aberto;
                            if root.chat-aberto { root.chat-nao-lidas = 0; }
                        }
                    }
                    Botao {
                        altura: 32px;
                        texto: @tr("Sair da tela cheia");
                        primario: true;
                        clicado => { root.mudar-tela-cheia(false); }
                    }
                }
            }
            if root.dica-tela-cheia && root.tela-cheia: DicaTelaCheia {
                width: min(parent.width - 32px, 520px);
                x: (parent.width - self.width) / 2;
                y: parent.height / 3 - self.height / 2;
            }
        }
    }
    Timer {
        interval: 5s;
        running: root.toast != "";
        triggered => { root.toast = ""; }
    }
    Timer {
        interval: 4s;
        running: root.dica-tela-cheia;
        triggered => { root.dica-tela-cheia = false; }
    }
    // Painel de arquivos (fase 3), por cima do vídeo.
    ArquivosNaSessao { width: parent.width; height: parent.height; }
}

// Um monitor do host numa janela própria (aba destacada, `13-multimonitor.md` §2.2): só o vídeo,
// o cursor e uma barra fina com tela cheia e "voltar para abas". Fechar a janela devolve a aba.
export component JanelaMonitor inherits Window {
    in property <string> host;
    in property <string> monitor;
    in property <bool> ao-vivo;
    in property <bool> terminou;
    in property <image> quadro;
    in property <bool> tem-video;
    in property <image> cursor;
    in property <bool> cursor-visivel;
    in property <length> cursor-x;
    in property <length> cursor-y;
    in-out property <bool> tela-cheia: false;
    in-out property <bool> dica-tela-cheia: false;
    out property <length> area-largura: video.width;
    out property <length> area-altura: video.height;

    callback voltar();
    callback mudar-tela-cheia(bool);
    callback mouse-moveu(length, length);
    callback mouse-botao(PointerEventButton, bool, length, length);
    callback mouse-rolou(length, length);

    title: root.host + " · " + root.monitor + " · TailDesk";
    icon: @image-url("icones/taildesk-64.png");
    preferred-width: 1280px;
    preferred-height: 760px;
    background: black;

    VerticalLayout {
        if !root.tela-cheia: Rectangle {
            height: 36px;
            background: Tema.superficie;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 8px;
                spacing: 8px;
                Text {
                    text: root.host + " · " + root.monitor;
                    font-size: Tema.fonte-pequena;
                    color: Tema.texto;
                    vertical-alignment: center;
                }
                Rectangle { }
                Botao {
                    y: 2px;
                    altura: 32px;
                    texto: @tr("⛶ Tela cheia");
                    discreto: true;
                    clicado => { root.mudar-tela-cheia(true); }
                }
                Botao {
                    y: 2px;
                    altura: 32px;
                    texto: @tr("Voltar para abas");
                    discreto: true;
                    clicado => { root.voltar(); }
                }
            }
        }
        video := Rectangle {
            background: black;
            Image {
                width: 100%;
                height: 100%;
                source: root.quadro;
                image-fit: contain;
                visible: root.tem-video;
            }
            if root.cursor-visivel && root.ao-vivo: Image {
                x: root.cursor-x;
                y: root.cursor-y;
                source: root.cursor;
            }
            TouchArea {
                mouse-cursor: root.ao-vivo ? MouseCursor.none : MouseCursor.default;
                moved => { root.mouse-moveu(self.mouse-x, self.mouse-y); }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.mouse-botao(e.button, true, self.mouse-x, self.mouse-y);
                    } else if e.kind == PointerEventKind.up {
                        root.mouse-botao(e.button, false, self.mouse-x, self.mouse-y);
                    } else if e.kind == PointerEventKind.move && !self.pressed {
                        root.mouse-moveu(self.mouse-x, self.mouse-y);
                    }
                }
                scroll-event(e) => {
                    root.mouse-rolou(e.delta-x, e.delta-y);
                    accept
                }
            }
            // Em tela cheia, o mouse na borda de cima mostra o botão de sair.
            if root.tela-cheia: borda := TouchArea {
                y: 0;
                height: sair.visible ? sair.height + 16px : 6px;
                Rectangle {
                    background: borda.has-hover ? #000000a0 : transparent;
                }
                sair := Botao {
                    visible: borda.has-hover;
                    x: (parent.width - self.width) / 2;
                    y: 8px;
                    altura: 32px;
                    texto: @tr("Sair da tela cheia (Ctrl+Alt+F)");
                    clicado => { root.mudar-tela-cheia(false); }
                }
            }
            if root.terminou && root.tem-video: Rectangle {
                background: #000000d9;
            }
            if !root.tem-video || root.terminou: Text {
                text: root.terminou ? @tr("Sessão encerrada") : @tr("Esperando o vídeo do monitor…");
                color: #e9ebef;
                font-size: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.dica-tela-cheia && root.tela-cheia: DicaTelaCheia {
                width: min(parent.width - 32px, 520px);
                x: (parent.width - self.width) / 2;
                y: parent.height / 3 - self.height / 2;
            }
        }
    }
    Timer {
        interval: 4s;
        running: root.dica-tela-cheia;
        triggered => { root.dica-tela-cheia = false; }
    }
}
