// Janela principal do app: dispositivos da tailnet (levantamento §5.2) e configurações (§5.9),
// com o estado real do Tailscale deste computador (§5.1 e "Tailscale parou durante o uso").
import { AboutSlint, ComboBox, LineEdit, ScrollView, Switch, ListView } from "std-widgets.slint";
import { Tema } from "tema.slint";
import { Botao, Cartao, ChipStatus, Dispositivo, Estado, ItemNav, LinhaInfo, PontoStatus, Separador, Textos, Toast } from "componentes.slint";
import { CartaoAtualizacoes, FaixaAtualizacao, InfoAtualizacao } from "atualizacao.slint";

// Como está o Tailscale deste computador, lido pela LocalAPI.
export enum EstadoTailscale {
    verificando,
    // Sem resposta no socket da LocalAPI: não instalado ou serviço parado.
    nao-encontrado,
    // A LocalAPI recusou este usuário.
    sem-permissao,
    // Rodando, mas sem login ou desligado (NeedsLogin, Stopped).
    desconectado,
    conectado,
}

// Copia para a área de transferência usando um campo de texto escondido.
component Copiador inherits TextInput {
    visible: false;
    width: 0;
    height: 0;
    read-only: true;
    public function copiar(t: string) {
        self.text = t;
        self.select-all();
        self.copy();
    }
}

// Comando de terminal com botão Copiar.
component Comando inherits Rectangle {
    in property <string> texto;
    callback copiar(string);
    height: 36px;
    border-radius: Tema.raio;
    background: Tema.superficie-2;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;
        Text {
            horizontal-stretch: 1;
            text: "$ " + root.texto;
            font-family: "DejaVu Sans Mono";
            font-size: Tema.fonte-pequena;
            color: Tema.texto;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Botao { texto: @tr("Copiar"); discreto: true; altura: 26px; clicado => { root.copiar(root.texto); } }
        }
    }
}

// Faixa no topo quando o Tailscale não está pronto: diz o motivo e o que fazer.
component FaixaTailscale inherits Rectangle {
    in property <EstadoTailscale> estado;
    in property <bool> linux;
    in property <bool> versao-antiga;
    in property <string> versao;
    in property <string> detalhe;
    callback abrir-link(string);
    callback copiar(string);
    callback verificar();

    property <bool> grave: estado != EstadoTailscale.conectado && estado != EstadoTailscale.verificando;
    background: grave ? Tema.perigo.with-alpha(0.12) : Tema.relay.with-alpha(0.16);

    VerticalLayout {
        padding: 12px;
        padding-left: 20px;
        padding-right: 20px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                wrap: word-wrap;
                font-weight: 600;
                color: Tema.texto;
                font-size: Tema.fonte;
                text: root.estado == EstadoTailscale.verificando ? @tr("Procurando o Tailscale deste computador…")
                    : root.estado == EstadoTailscale.nao-encontrado ? @tr("O Tailscale não foi encontrado. O TailDesk usa o Tailscale instalado neste computador (versão 1.102 ou mais nova) para achar e conectar suas máquinas.")
                    : root.estado == EstadoTailscale.sem-permissao ? @tr("O Tailscale está rodando, mas não deixa este usuário consultar o estado dele.")
                    : root.estado == EstadoTailscale.desconectado ? @tr("O Tailscale está instalado, mas não está conectado à sua tailnet. As conexões voltam quando ele reconectar.")
                    : @tr("O Tailscale deste computador ({}) é mais antigo que o recomendado (1.102). Atualize para conexões estáveis.", root.versao);
            }
            if root.estado == EstadoTailscale.nao-encontrado || root.versao-antiga: VerticalLayout {
                alignment: center;
                Botao { texto: @tr("Baixar o Tailscale"); primario: true; altura: 28px; clicado => { root.abrir-link("https://tailscale.com/download"); } }
            }
            if root.grave: VerticalLayout {
                alignment: center;
                Botao { texto: @tr("Verificar de novo"); altura: 28px; clicado => { root.verificar(); } }
            }
        }
        if root.linux && root.estado == EstadoTailscale.nao-encontrado: VerticalLayout {
            spacing: 6px;
            Text { text: @tr("Se ele já está instalado, ligue o serviço:"); color: Tema.texto-2; font-size: Tema.fonte-pequena; }
            Comando { texto: "sudo systemctl enable --now tailscaled"; copiar(t) => { root.copiar(t); } }
        }
        if root.linux && root.estado == EstadoTailscale.desconectado: VerticalLayout {
            spacing: 6px;
            Text { text: @tr("Entre na sua tailnet pelo terminal (o navegador abre a página de login):"); color: Tema.texto-2; font-size: Tema.fonte-pequena; }
            Comando { texto: "sudo tailscale up"; copiar(t) => { root.copiar(t); } }
        }
        if !root.linux && root.estado == EstadoTailscale.desconectado: Text {
            text: @tr("Abra o Tailscale pela bandeja do Windows e faça login.");
            color: Tema.texto-2;
            font-size: Tema.fonte-pequena;
        }
        if root.linux && root.estado == EstadoTailscale.sem-permissao: VerticalLayout {
            spacing: 6px;
            Text { text: @tr("Deixe seu usuário operar o Tailscale:"); color: Tema.texto-2; font-size: Tema.fonte-pequena; }
            Comando { texto: "sudo tailscale set --operator=$USER"; copiar(t) => { root.copiar(t); } }
        }
        if root.grave && root.detalhe != "": Text {
            text: root.detalhe;
            color: Tema.texto-2;
            font-size: Tema.fonte-pequena;
            wrap: word-wrap;
        }
    }
}

component ItemDispositivo inherits Rectangle {
    in property <Dispositivo> d;
    in property <bool> selecionado;
    callback selecionar();
    callback conectar();

    accessible-role: list-item;
    accessible-label: d.nome + ", " + d.so + ", " + Textos.estado(d.estado);
    height: 60px;
    border-radius: Tema.raio;
    background: selecionado ? Tema.superficie-2 : toque.has-hover ? Tema.superficie-2.with-alpha(0.5) : transparent;

    toque := TouchArea {
        clicked => { root.selecionar(); }
        double-clicked => { if Textos.conectavel(root.d.estado) { root.conectar(); } }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.d.nome;
                font-size: 14px;
                font-weight: 600;
                color: root.d.estado == Estado.nao-suportado ? Tema.texto-2 : Tema.texto;
            }
            Text { text: root.d.so; font-size: Tema.fonte-pequena; color: Tema.texto-2; }
        }
        VerticalLayout {
            alignment: center;
            width: 150px;
            ChipStatus { estado: root.d.estado; }
        }
        VerticalLayout {
            alignment: center;
            width: 120px;
            if Textos.conectavel(root.d.estado): Botao {
                texto: @tr("Conectar");
                primario: true;
                clicado => { root.conectar(); }
            }
        }
    }
}

component PainelDetalhe inherits Rectangle {
    in property <Dispositivo> d;
    callback conectar();
    callback copiar(string);
    background: Tema.superficie;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;
        alignment: start;
        VerticalLayout {
            spacing: 4px;
            Text { text: root.d.nome; font-size: 18px; font-weight: 700; color: Tema.texto; wrap: word-wrap; }
            Text { text: root.d.so; font-size: Tema.fonte; color: Tema.texto-2; }
        }
        ChipStatus { estado: root.d.estado; }
        Botao {
            texto: @tr("Conectar");
            primario: true;
            habilitado: Textos.conectavel(root.d.estado);
            clicado => { root.conectar(); }
        }
        Separador { }
        LinhaInfo {
            rotulo: @tr("Endereço na tailnet");
            valor: root.d.ip;
            acao: root.d.ip != "" ? @tr("Copiar") : "";
            acionar => { root.copiar(root.d.ip); }
        }
        LinhaInfo {
            rotulo: @tr("MagicDNS");
            valor: root.d.dns;
            acao: root.d.dns != "" ? @tr("Copiar") : "";
            acionar => { root.copiar(root.d.dns); }
        }
        LinhaInfo { rotulo: @tr("Visto por último"); valor: root.d.ultimo-acesso; }
        if root.d.estado == Estado.nao-suportado: Text {
            wrap: word-wrap;
            text: @tr("O TailDesk ainda não roda neste sistema. Por enquanto: Windows e Linux.");
            font-size: Tema.fonte-pequena;
            color: Tema.texto-2;
        }
    }
}

component SecaoDispositivos inherits Rectangle {
    in property <[Dispositivo]> dispositivos;
    in property <int> total;
    in property <bool> pronto;
    in-out property <int> selecionado;
    in-out property <string> busca;
    callback busca-mudou(string);
    callback conectar(Dispositivo);
    callback copiar(string);

    HorizontalLayout {
        VerticalLayout {
            horizontal-stretch: 1;
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: @tr("Dispositivos");
                    font-size: Tema.fonte-titulo;
                    font-weight: 700;
                    color: Tema.texto;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                LineEdit {
                    width: 260px;
                    placeholder-text: @tr("Buscar dispositivos");
                    text <=> root.busca;
                    edited(t) => { root.busca-mudou(t); }
                }
            }
            if root.pronto && root.total == 0: Text {
                text: @tr("Nenhum outro dispositivo na sua tailnet ainda. Instale o Tailscale e o TailDesk em outro computador e ele aparece aqui.");
                color: Tema.texto-2;
                font-size: Tema.fonte;
                wrap: word-wrap;
            }
            if root.total > 0 && root.dispositivos.length == 0: Text {
                text: @tr("Nenhum dispositivo encontrado para “{}”.", root.busca);
                color: Tema.texto-2;
                font-size: Tema.fonte;
            }
            ListView {
                vertical-stretch: 1;
                for d[i] in root.dispositivos: ItemDispositivo {
                    d: d;
                    selecionado: i == root.selecionado;
                    selecionar => { root.selecionado = i; }
                    conectar => { root.conectar(d); }
                }
            }
        }
        Rectangle { width: 1px; background: Tema.borda; }
        if root.dispositivos.length > 0: PainelDetalhe {
            width: 300px;
            d: root.dispositivos[min(root.selecionado, root.dispositivos.length - 1)];
            conectar => { root.conectar(self.d); }
            copiar(t) => { root.copiar(t); }
        }
    }
}

component OpcaoConfig inherits HorizontalLayout {
    in property <string> titulo;
    in property <string> descricao;
    in-out property <bool> ligado;
    callback mudou(bool);
    spacing: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 3px;
        Text { text: root.titulo; color: Tema.texto; font-size: Tema.fonte; font-weight: 600; }
        Text { text: root.descricao; color: Tema.texto-2; font-size: Tema.fonte-pequena; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        Switch { checked <=> root.ligado; toggled => { root.mudou(self.checked); } }
    }
}

// Título de grupo das Configurações.
component TituloGrupo inherits Text {
    font-weight: 700;
    color: Tema.texto-2;
    font-size: Tema.fonte-pequena;
}

// Linha com rótulo, descrição e uma lista de escolha à direita.
component OpcaoLista inherits HorizontalLayout {
    in property <string> titulo;
    in property <string> descricao;
    in property <[string]> opcoes;
    in-out property <int> escolhida;
    callback mudou(int);
    spacing: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 3px;
        Text { text: root.titulo; color: Tema.texto; font-size: Tema.fonte; font-weight: 600; }
        if root.descricao != "": Text { text: root.descricao; color: Tema.texto-2; font-size: Tema.fonte-pequena; wrap: word-wrap; }
    }
    VerticalLayout {
        alignment: center;
        ComboBox {
            width: 200px;
            model: root.opcoes;
            current-index <=> root.escolhida;
            selected => { root.mudou(self.current-index); }
        }
    }
}

// Uma linha do histórico de acessos (Configurações → Histórico de acessos).
export struct LinhaAcesso {
    quando: string,
    quem: string,
    texto: string,
    // Recusa que merece atenção (senha errada, fora da tailnet).
    alerta: bool,
}

component ItemAcesso inherits HorizontalLayout {
    in property <LinhaAcesso> a;
    spacing: 10px;
    padding-top: 4px;
    padding-bottom: 4px;
    Text { width: 86px; text: root.a.quando; font-size: Tema.fonte-pequena; color: Tema.texto-2; vertical-alignment: center; }
    VerticalLayout {
        horizontal-stretch: 1;
        Text { text: root.a.quem; font-size: Tema.fonte; color: Tema.texto; overflow: elide; }
        Text { text: root.a.texto; font-size: Tema.fonte-pequena; color: root.a.alerta ? Tema.perigo : Tema.texto-2; wrap: word-wrap; }
    }
}

// Um dispositivo confiável com o botão Revogar.
component LinhaConfiavel inherits HorizontalLayout {
    in property <string> nome;
    callback revogar();
    spacing: 8px;
    padding-top: 4px;
    padding-bottom: 4px;
    VerticalLayout { alignment: center; PontoStatus { estado: Estado.online; } }
    Text { horizontal-stretch: 1; text: root.nome; color: Tema.texto; font-size: Tema.fonte; vertical-alignment: center; overflow: elide; }
    Botao { texto: @tr("Revogar"); discreto: true; perigo: true; altura: 26px; clicado => { root.revogar(); } }
}

// "Acesso com senha": definir, trocar ou remover a senha deste computador.
component OpcaoSenha inherits VerticalLayout {
    in property <bool> tem-senha;
    in-out property <bool> editando;
    in property <string> erro;
    callback definir(string, string);
    callback remover();
    padding-top: 10px;
    padding-bottom: 10px;
    spacing: 8px;
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            Text { text: @tr("Acesso com senha"); color: Tema.texto; font-size: Tema.fonte; font-weight: 600; }
            Text {
                text: root.tem-senha
                    ? @tr("Ligado. Quem souber a senha entra sem você aceitar, mesmo sem ninguém na frente da tela. O aviso de sessão ativa aparece do mesmo jeito.")
                    : @tr("Desligado. Com uma senha, você entra neste computador de longe sem ninguém precisar aceitar.");
                color: Tema.texto-2;
                font-size: Tema.fonte-pequena;
                wrap: word-wrap;
            }
        }
        if !root.editando: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 6px;
                if root.tem-senha: Botao { texto: @tr("Remover"); discreto: true; perigo: true; clicado => { root.remover(); } }
                Botao { texto: root.tem-senha ? @tr("Trocar senha") : @tr("Definir senha"); clicado => { root.editando = true; } }
            }
        }
    }
    if root.editando: VerticalLayout {
        spacing: 6px;
        nova := LineEdit { input-type: password; placeholder-text: @tr("Nova senha (pelo menos 8 caracteres)"); }
        confirma := LineEdit {
            input-type: password;
            placeholder-text: @tr("Repita a senha");
            accepted => { root.definir(nova.text, confirma.text); }
        }
        if root.erro != "": Text { text: root.erro; color: Tema.perigo; font-size: Tema.fonte-pequena; wrap: word-wrap; }
        HorizontalLayout {
            alignment: end;
            spacing: 6px;
            Botao { texto: @tr("Cancelar"); discreto: true; clicado => { root.editando = false; } }
            Botao {
                texto: @tr("Salvar senha");
                primario: true;
                habilitado: nova.text != "";
                clicado => { root.definir(nova.text, confirma.text); }
            }
        }
    }
}

component SecaoConfiguracoes inherits ScrollView {
    in-out property <bool> aceitando;
    in-out property <bool> pedir-sempre;
    in property <[string]> confiaveis;
    in property <bool> tem-senha;
    in-out property <bool> editando-senha;
    in property <string> erro-senha;
    in-out property <bool> iniciar-com-sistema;
    in property <string> pasta-entrada;
    in property <[LinhaAcesso]> acessos;
    in property <string> tailscale;
    in property <string> versao-app;
    in property <bool> bandeja;
    in property <InfoAtualizacao> atualizacao;
    in-out property <bool> atualizar-auto;
    in-out property <bool> canal-pre;
    in property <[string]> codecs;
    in-out property <int> codec;
    in property <[string]> taxas;
    in-out property <int> taxa;
    in property <string> video-local;
    in property <string> teclado-local;
    callback aceitando-mudou(bool);
    callback pedir-sempre-mudou(bool);
    callback revogar(int);
    callback definir-senha(string, string);
    callback remover-senha();
    callback iniciar-com-sistema-mudou(bool);
    callback abrir-pasta-entrada();
    callback abrir-registros();
    callback codec-mudou(int);
    callback taxa-mudou(int);
    callback abrir-link(string);
    callback atualizar-auto-mudou(bool);
    callback canal-pre-mudou(bool);
    callback procurar-atualizacao();
    callback atualizar-agora();
    callback reiniciar-app();
    HorizontalLayout {
        alignment: center;
        VerticalLayout {
            // Em janela larga o texto não se espalha: coluna de no máximo 760 px.
            width: min(root.visible-width, 800px);
            padding: 20px;
            spacing: 10px;
            alignment: start;
            Text { text: @tr("Configurações"); font-size: Tema.fonte-titulo; font-weight: 700; color: Tema.texto; }

            TituloGrupo { text: @tr("Este computador"); }
            Cartao {
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    OpcaoConfig {
                        titulo: @tr("Aceitar conexões");
                        descricao: @tr("Outros dispositivos da sua tailnet podem pedir acesso a este computador. Nada acontece sem você permitir.");
                        ligado <=> root.aceitando;
                        mudou(v) => { root.aceitando-mudou(v); }
                    }
                    Separador { }
                    OpcaoConfig {
                        titulo: @tr("Pedir minha permissão a cada conexão");
                        descricao: @tr("Desligado, os dispositivos confiáveis abaixo entram sem perguntar. O aviso de sessão ativa aparece sempre.");
                        ligado <=> root.pedir-sempre;
                        mudou(v) => { root.pedir-sempre-mudou(v); }
                    }
                    Separador { }
                    OpcaoSenha {
                        tem-senha: root.tem-senha;
                        editando <=> root.editando-senha;
                        erro: root.erro-senha;
                        definir(a, b) => { root.definir-senha(a, b); }
                        remover => { root.remover-senha(); }
                    }
                    Separador { }
                    OpcaoConfig {
                        titulo: @tr("Iniciar com o sistema");
                        descricao: @tr("O TailDesk abre escondido na bandeja quando você entra no computador e fica pronto para receber conexões, sem precisar abrir o app. Junto com o acesso com senha, dá para entrar de longe sem ninguém na frente da tela.");
                        ligado <=> root.iniciar-com-sistema;
                        mudou(v) => { root.iniciar-com-sistema-mudou(v); }
                    }
                    Separador { }
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        Text { text: @tr("Dispositivos confiáveis"); font-size: Tema.fonte-pequena; color: Tema.texto-2; }
                        if root.confiaveis.length == 0: Text {
                            text: @tr("Nenhum. Marque “Lembrar deste dispositivo” no pedido de acesso para não precisar aceitar de novo.");
                            font-size: Tema.fonte;
                            color: Tema.texto;
                            wrap: word-wrap;
                        }
                        for nome[i] in root.confiaveis: LinhaConfiavel {
                            nome: nome;
                            revogar => { root.revogar(i); }
                        }
                    }
                    Separador { }
                    LinhaInfo {
                        rotulo: @tr("Pasta de entrada");
                        valor: root.pasta-entrada != "" ? root.pasta-entrada : @tr("Pasta de downloads não encontrada");
                        acao: root.pasta-entrada != "" ? @tr("Abrir") : "";
                        acionar => { root.abrir-pasta-entrada(); }
                    }
                    Separador { }
                    LinhaInfo {
                        rotulo: @tr("Ao fechar a janela");
                        valor: root.bandeja ? @tr("O TailDesk continua na bandeja do sistema. Para sair, use Sair no menu do ícone.") : @tr("O sistema não tem bandeja: fechar a janela encerra o TailDesk.");
                    }
                }
            }

            TituloGrupo { text: @tr("Histórico de acessos"); }
            Cartao {
                VerticalLayout {
                    padding: 16px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 2px;
                    if root.acessos.length == 0: Text {
                        text: @tr("Ninguém acessou este computador ainda.");
                        font-size: Tema.fonte;
                        color: Tema.texto;
                    }
                    for a in root.acessos: ItemAcesso { a: a; }
                    Separador { }
                    LinhaInfo {
                        rotulo: @tr("Registro completo");
                        valor: @tr("Cada acesso e cada arquivo trocado ficam gravados neste computador.");
                        acao: @tr("Abrir pasta");
                        acionar => { root.abrir-registros(); }
                    }
                }
            }

            TituloGrupo { text: @tr("Sessão"); }
            Cartao {
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    OpcaoLista {
                        titulo: @tr("Codec de vídeo");
                        descricao: @tr("Automático usa o melhor que as duas máquinas têm em hardware. Se o escolhido faltar de um lado, a sessão volta ao automático.");
                        opcoes: root.codecs;
                        escolhida <=> root.codec;
                        mudou(i) => { root.codec-mudou(i); }
                    }
                    Separador { }
                    OpcaoLista {
                        titulo: @tr("Taxa de bits");
                        descricao: @tr("Automática ajusta ao tamanho da tela e à rede. Uma taxa fixa alta pede uma rede rápida.");
                        opcoes: root.taxas;
                        escolhida <=> root.taxa;
                        mudou(i) => { root.taxa-mudou(i); }
                    }
                    Separador { }
                    VerticalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 2px;
                        Text { text: @tr("Vídeo deste computador"); font-size: Tema.fonte-pequena; color: Tema.texto-2; }
                        Text { text: root.video-local; font-size: Tema.fonte; color: Tema.texto; wrap: word-wrap; }
                    }
                    Separador { }
                    LinhaInfo {
                        rotulo: @tr("Teclado");
                        valor: root.teclado-local != "" ? @tr("Automático: traduz quando os layouts são diferentes (este computador: {})", root.teclado-local) : @tr("Automático: traduz quando os layouts são diferentes");
                    }
                }
            }

            TituloGrupo { text: @tr("Rede"); }
            Cartao {
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    LinhaInfo { rotulo: @tr("Tailscale deste computador"); valor: root.tailscale; }
                    Separador { }
                    LinhaInfo {
                        rotulo: @tr("Conta, login e saída da tailnet");
                        valor: @tr("Ficam com o próprio Tailscale; o TailDesk não muda nada nele.");
                        acao: @tr("Painel do Tailscale");
                        acionar => { root.abrir-link("https://login.tailscale.com/admin/machines"); }
                    }
                }
            }

            TituloGrupo { text: @tr("Atualizações"); }
            CartaoAtualizacoes {
                info: root.atualizacao;
                automatica <=> root.atualizar-auto;
                pre <=> root.canal-pre;
                automatica-mudou(v) => { root.atualizar-auto-mudou(v); }
                pre-mudou(v) => { root.canal-pre-mudou(v); }
                procurar => { root.procurar-atualizacao(); }
                atualizar => { root.atualizar-agora(); }
                reiniciar => { root.reiniciar-app(); }
                abrir-link(u) => { root.abrir-link(u); }
            }

            // Atribuição exigida pela licença royalty-free do Slint para apps desktop.
            TituloGrupo { text: @tr("Sobre"); }
            Cartao {
                VerticalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    LinhaInfo {
                        rotulo: @tr("TailDesk {}", root.versao-app);
                        valor: @tr("Código aberto, MIT OR Apache-2.0");
                        acao: @tr("Abrir no GitHub");
                        acionar => { root.abrir-link("https://github.com/yurisanp/taildesk"); }
                    }
                }
            }
            AboutSlint { }
        }
    }
}

export component JanelaPrincipal inherits Window {
    title: "TailDesk";
    icon: @image-url("icones/taildesk-64.png");
    preferred-width: 1040px;
    preferred-height: 660px;
    min-width: 760px;
    min-height: 480px;
    background: Tema.fundo;
    default-font-family: "Inter";

    // Lista já filtrada pela busca; `total` é o tamanho sem filtro.
    in property <[Dispositivo]> dispositivos;
    in property <int> total;
    in-out property <int> selecionado: 0;
    in-out property <string> busca;
    in-out property <int> secao: 0;
    in property <string> este-pc;
    in-out property <bool> aceitando: true;
    in-out property <bool> pedir-sempre: true;
    in property <[string]> confiaveis;
    in property <bool> tem-senha;
    in-out property <bool> editando-senha;
    in property <string> erro-senha;
    in-out property <bool> iniciar-com-sistema;
    in property <string> pasta-entrada;
    in property <[LinhaAcesso]> acessos;
    in property <[string]> codecs-config: [@tr("Automático"), "H.264", "HEVC", "AV1", "PyroWave"];
    in-out property <int> codec-config: 0;
    in property <[string]> taxas-config;
    in-out property <int> taxa-config: 0;
    in property <string> video-local: @tr("Verificando…");
    in property <string> teclado-local;
    in-out property <string> toast;
    in property <EstadoTailscale> tailscale: EstadoTailscale.verificando;
    in property <string> tailscale-resumo;
    in property <string> tailscale-detalhe;
    in property <string> versao-tailscale;
    in property <bool> versao-antiga;
    in property <bool> linux;
    in property <string> versao-app;
    in property <bool> bandeja;
    in property <InfoAtualizacao> atualizacao;
    in-out property <bool> atualizar-auto: true;
    in-out property <bool> canal-pre;

    callback busca-mudou(string);
    callback conectar(Dispositivo);
    callback abrir-link(string);
    callback verificar();
    callback aceitando-mudou(bool);
    callback pedir-sempre-mudou(bool);
    callback revogar(int);
    callback definir-senha(string, string);
    callback remover-senha();
    callback iniciar-com-sistema-mudou(bool);
    callback abrir-pasta-entrada();
    callback abrir-registros();
    callback codec-config-mudou(int);
    callback taxa-config-mudou(int);
    callback atualizar-auto-mudou(bool);
    callback canal-pre-mudou(bool);
    callback procurar-atualizacao();
    callback atualizar-agora();
    callback reiniciar-app();
    callback dispensar-atualizacao();

    function copiar(t: string) {
        copiador.copiar(t);
        root.toast = @tr("Copiado: {}", t);
    }

    copiador := Copiador { }

    HorizontalLayout {
        Rectangle {
            width: 200px;
            background: Tema.superficie;
            VerticalLayout {
                padding: 14px;
                spacing: 4px;
                HorizontalLayout {
                    padding-bottom: 14px;
                    spacing: 8px;
                    Image { width: 26px; height: 26px; source: @image-url("../../../packaging/linux/taildesk.svg"); }
                    Text { text: "TailDesk"; font-size: 17px; font-weight: 700; color: Tema.texto; vertical-alignment: center; }
                }
                ItemNav { texto: @tr("Dispositivos"); ativo: root.secao == 0; clicado => { root.secao = 0; } }
                ItemNav { texto: @tr("Configurações"); ativo: root.secao == 1; clicado => { root.secao = 1; } }
                Rectangle { vertical-stretch: 1; }
                Separador { }
                VerticalLayout {
                    padding-top: 10px;
                    padding-bottom: 6px;
                    spacing: 4px;
                    Text {
                        text: root.este-pc != "" ? root.este-pc + @tr(" (este PC)") : @tr("Este PC");
                        font-size: Tema.fonte-pequena;
                        font-weight: 600;
                        color: Tema.texto;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        VerticalLayout { alignment: center; PontoStatus { estado: root.aceitando ? Estado.online : Estado.offline; } }
                        Text {
                            text: root.aceitando ? @tr("Aceitando conexões") : @tr("Não aceita conexões");
                            font-size: Tema.fonte-pequena;
                            color: Tema.texto-2;
                        }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Tema.borda; }
        VerticalLayout {
            horizontal-stretch: 1;
            if root.tailscale != EstadoTailscale.conectado || root.versao-antiga: FaixaTailscale {
                estado: root.tailscale;
                linux: root.linux;
                versao-antiga: root.versao-antiga;
                versao: root.versao-tailscale;
                detalhe: root.tailscale-detalhe;
                abrir-link(u) => { root.abrir-link(u); }
                copiar(t) => { root.copiar(t); }
                verificar => { root.verificar(); }
            }
            if root.atualizacao.aviso: FaixaAtualizacao {
                info: root.atualizacao;
                procurar => { root.procurar-atualizacao(); }
                atualizar => { root.atualizar-agora(); }
                reiniciar => { root.reiniciar-app(); }
                dispensar => { root.dispensar-atualizacao(); }
                abrir-link(u) => { root.abrir-link(u); }
            }
            if root.secao == 0: SecaoDispositivos {
                vertical-stretch: 1;
                opacity: root.tailscale == EstadoTailscale.conectado ? 1 : 0.5;
                dispositivos: root.dispositivos;
                total: root.total;
                pronto: root.tailscale == EstadoTailscale.conectado;
                selecionado <=> root.selecionado;
                busca <=> root.busca;
                busca-mudou(t) => { root.busca-mudou(t); }
                conectar(d) => { root.conectar(d); }
                copiar(t) => { root.copiar(t); }
            }
            if root.secao == 1: SecaoConfiguracoes {
                vertical-stretch: 1;
                aceitando <=> root.aceitando;
                pedir-sempre <=> root.pedir-sempre;
                confiaveis: root.confiaveis;
                tem-senha: root.tem-senha;
                editando-senha <=> root.editando-senha;
                erro-senha: root.erro-senha;
                definir-senha(a, b) => { root.definir-senha(a, b); }
                remover-senha => { root.remover-senha(); }
                iniciar-com-sistema <=> root.iniciar-com-sistema;
                iniciar-com-sistema-mudou(v) => { root.iniciar-com-sistema-mudou(v); }
                pasta-entrada: root.pasta-entrada;
                acessos: root.acessos;
                abrir-registros => { root.abrir-registros(); }
                codecs: root.codecs-config;
                codec <=> root.codec-config;
                taxas: root.taxas-config;
                taxa <=> root.taxa-config;
                video-local: root.video-local;
                teclado-local: root.teclado-local;
                pedir-sempre-mudou(v) => { root.pedir-sempre-mudou(v); }
                revogar(i) => { root.revogar(i); }
                abrir-pasta-entrada => { root.abrir-pasta-entrada(); }
                codec-mudou(i) => { root.codec-config-mudou(i); }
                taxa-mudou(i) => { root.taxa-config-mudou(i); }
                tailscale: root.tailscale-resumo;
                versao-app: root.versao-app;
                bandeja: root.bandeja;
                atualizacao: root.atualizacao;
                atualizar-auto <=> root.atualizar-auto;
                canal-pre <=> root.canal-pre;
                aceitando-mudou(v) => { root.aceitando-mudou(v); }
                abrir-link(u) => { root.abrir-link(u); }
                atualizar-auto-mudou(v) => { root.atualizar-auto-mudou(v); }
                canal-pre-mudou(v) => { root.canal-pre-mudou(v); }
                procurar-atualizacao => { root.procurar-atualizacao(); }
                atualizar-agora => { root.atualizar-agora(); }
                reiniciar-app => { root.reiniciar-app(); }
            }
        }
    }

    Toast {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 20px;
        texto: root.toast;
    }
    Timer {
        interval: 4s;
        running: root.toast != "";
        triggered => { root.toast = ""; }
    }
}
