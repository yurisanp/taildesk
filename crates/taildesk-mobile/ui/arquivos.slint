// Folha de arquivos da sessão (MF-60): sobe de baixo no celular e vira painel lateral no tablet.
// Navega nas pastas que o host libera, baixa (toque num arquivo) e envia (seletor do sistema).
// O estado vem de `taildesk_mobile::arquivos::Folha`.
import { Tema } from "tema.slint";
import { Botao, Separador } from "componentes.slint";

export struct ItemArquivo {
    nome: string,
    // "12 KB · 03/11/2026"; vazio para pastas e raízes.
    detalhe: string,
    pasta: bool,
    permitido: bool,
}

export struct LinhaArquivo {
    id: int,
    nome: string,
    enviando: bool,
    // 0 esperando, 1 em andamento, 2 concluída, 3 falhou, 4 cancelada
    estado: int,
    progresso: float,
    // "3,2 MB de 10 MB · 1,1 MB/s", "Salvo em Download/TailDesk", o motivo da falha.
    detalhe: string,
}

export component FolhaArquivos inherits Rectangle {
    // Caminho da pasta aberta; vazio = lista de pastas liberadas.
    in property <string> titulo;
    in property <[ItemArquivo]> itens;
    in property <bool> carregando;
    in property <string> erro;
    in property <[LinhaArquivo]> transferencias;
    // Pergunta de arquivo grande em rede tarifada (MF-64); vazio = sem pergunta.
    in property <string> pergunta;
    callback tocado(int);
    callback voltar();
    callback enviar();
    callback cancelar(int);
    callback responder(bool);
    callback fechar();

    property <bool> lateral: root.width > 700px;

    background: #00000066;
    TouchArea { clicked => { root.fechar(); } }

    Rectangle {
        x: root.lateral ? parent.width - self.width : 0;
        y: root.lateral ? 0 : parent.height - self.height;
        width: root.lateral ? 420px : parent.width;
        height: root.lateral ? parent.height : parent.height * 0.75;
        background: Tema.superficie;
        border-top-left-radius: 20px;
        border-top-right-radius: root.lateral ? 0 : 20px;
        border-bottom-left-radius: root.lateral ? 20px : 0;
        TouchArea { }

        VerticalLayout {
            padding: 16px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 8px;
                Botao {
                    width: Tema.toque;
                    texto: "←";
                    discreto: true;
                    accessible-label: @tr("Voltar");
                    clicado => { root.voltar(); }
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.titulo != "" ? root.titulo : @tr("Pastas do computador");
                    font-size: Tema.fonte-grande;
                    font-weight: 700;
                    color: Tema.texto;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Botao { texto: @tr("Enviar"); primario: true; clicado => { root.enviar(); } }
            }
            Separador { }

            Rectangle {
                vertical-stretch: 1;
                if root.carregando && root.itens.length == 0: Text {
                    text: @tr("Carregando…");
                    color: Tema.texto-2;
                    font-size: Tema.fonte;
                }
                if !root.carregando && root.erro != "": Text {
                    width: parent.width - 32px;
                    text: root.erro;
                    color: Tema.perigo;
                    font-size: Tema.fonte;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                if !root.carregando && root.erro == "" && root.itens.length == 0: Text {
                    width: parent.width - 32px;
                    text: root.titulo == ""
                        ? @tr("Este computador não liberou pastas. Você ainda pode enviar arquivos para a pasta de entrada dele.")
                        : @tr("Pasta vazia.");
                    color: Tema.texto-2;
                    font-size: Tema.fonte;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                Flickable {
                    content-height: lista.preferred-height;
                    lista := VerticalLayout {
                        alignment: start;
                        for it[i] in root.itens: Rectangle {
                            height: 56px;
                            accessible-role: button;
                            accessible-label: it.nome;
                            accessible-enabled: it.permitido;
                            accessible-action-default => { root.tocado(i); }
                            background: toque.pressed ? Tema.superficie-2 : transparent;
                            border-radius: 10px;
                            toque := TouchArea { enabled: it.permitido; clicked => { root.tocado(i); } }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 12px;
                                Text { text: it.pasta ? "📁" : "📄"; font-size: 22px; vertical-alignment: center; }
                                VerticalLayout {
                                    alignment: center;
                                    Text { text: it.nome; color: it.permitido ? Tema.texto : Tema.texto-2; font-size: Tema.fonte; overflow: elide; }
                                    if !it.permitido: Text { text: @tr("Sem permissão para abrir"); color: Tema.texto-2; font-size: Tema.fonte-pequena; }
                                    if it.permitido && it.detalhe != "": Text { text: it.detalhe; color: Tema.texto-2; font-size: Tema.fonte-pequena; }
                                }
                            }
                        }
                    }
                }
            }

            // Faixa de transferências, as mais recentes primeiro.
            if root.transferencias.length > 0: Separador { }
            if root.transferencias.length > 0: Text {
                text: @tr("Transferências");
                font-size: Tema.fonte-pequena;
                font-weight: 700;
                color: Tema.texto-2;
            }
            if root.transferencias.length > 0: Flickable {
                height: min(180px, faixa.preferred-height);
                content-height: faixa.preferred-height;
                faixa := VerticalLayout {
                    spacing: 8px;
                    for t in root.transferencias: HorizontalLayout {
                        spacing: 10px;
                        Text { text: t.enviando ? "↑" : "↓"; font-size: 18px; color: Tema.primaria; vertical-alignment: center; }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 3px;
                            Text { text: t.nome; color: Tema.texto; font-size: Tema.fonte; overflow: elide; }
                            if t.estado <= 1: Rectangle {
                                height: 4px;
                                border-radius: 2px;
                                background: Tema.superficie-2;
                                Rectangle {
                                    x: 0;
                                    width: parent.width * max(0, min(1, t.progresso));
                                    border-radius: 2px;
                                    background: Tema.primaria;
                                }
                            }
                            Text {
                                text: t.detalhe;
                                color: t.estado == 3 ? Tema.perigo : Tema.texto-2;
                                font-size: Tema.fonte-pequena;
                                overflow: elide;
                            }
                        }
                        if t.estado <= 1: Botao {
                            width: Tema.toque;
                            texto: "✕";
                            discreto: true;
                            accessible-label: @tr("Cancelar");
                            clicado => { root.cancelar(t.id); }
                        }
                    }
                }
            }
        }
    }

    // MF-64: arquivo grande em rede tarifada.
    if root.pergunta != "": Rectangle {
        background: #00000080;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 48px, 380px);
            height: caixa.preferred-height;
            background: Tema.superficie;
            border-radius: Tema.raio-grande;
            caixa := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text { text: @tr("Usar dados móveis?"); font-size: Tema.fonte-grande; font-weight: 700; color: Tema.texto; }
                Text { text: root.pergunta; font-size: Tema.fonte; color: Tema.texto-2; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Botao { horizontal-stretch: 1; texto: @tr("Agora não"); clicado => { root.responder(false); } }
                    Botao { horizontal-stretch: 1; texto: @tr("Continuar"); primario: true; clicado => { root.responder(true); } }
                }
            }
        }
    }
}
