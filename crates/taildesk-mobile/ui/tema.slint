// Tokens do TailDesk no celular: as cores do desktop (`crates/taildesk-ui/ui/tema.slint`) com
// tamanhos de toque (alvos ≥ 48 px lógicos = 48 dp, MNF-07) e fontes maiores.
import { Palette } from "std-widgets.slint";

export global Tema {
    in-out property <bool> escuro: Palette.color-scheme == ColorScheme.dark;

    out property <color> fundo: escuro ? #15171c : #f3f4f7;
    out property <color> superficie: escuro ? #1e2128 : #ffffff;
    out property <color> superficie-2: escuro ? #282c35 : #eceef2;
    out property <color> borda: escuro ? #353a45 : #dfe2e8;
    out property <color> texto: escuro ? #e9ebef : #1a1d23;
    out property <color> texto-2: escuro ? #a2a8b4 : #5a6170;
    out property <color> primaria: escuro ? #5b8cff : #2c5fe0;
    out property <color> primaria-forte: escuro ? #7aa2ff : #2149b8;
    out property <color> sobre-primaria: #ffffff;
    out property <color> online: #1f9d63;
    out property <color> relay: #d18f00;
    out property <color> offline: #9aa1ad;
    out property <color> perigo: escuro ? #ff6b60 : #d33b30;
    out property <color> aviso-fundo: escuro ? #3a3020 : #fff4d6;
    out property <color> aviso-texto: escuro ? #f3d48a : #7a5300;
    out property <color> barra-sessao: #1c1f26e6;

    out property <length> raio: 12px;
    out property <length> raio-grande: 16px;
    out property <length> toque: 48px;
    out property <length> fonte-pequena: 13px;
    out property <length> fonte: 15px;
    out property <length> fonte-grande: 17px;
    out property <length> fonte-titulo: 26px;
    out property <length> margem: 16px;
}
