# Maintainer: Yuri Sant'Ana <yurisantp@gmail.com>
# Pacote binário do TailDesk para o AUR: usa o .tar.gz publicado no GitHub Releases.
# O job `aur` do release.yml atualiza pkgver e sha256sums e envia a cada versão
# (packaging/arch/update-aur.sh).
pkgname=taildesk-bin
pkgver=0.0.1
pkgrel=1
pkgdesc="Acesso remoto (desktop remoto e troca de arquivos) pela tailnet do Tailscale"
arch=('x86_64')
url="https://github.com/yurisanp/taildesk"
license=('MIT OR Apache-2.0')
depends=('glibc' 'gcc-libs' 'fontconfig' 'libpipewire')
optdepends=('tailscale: rede e identidade pela tailnet (necessário em uso)')
provides=('taildesk')
conflicts=('taildesk')
source=("$url/releases/download/v$pkgver/taildesk-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
  cp -a "taildesk-$pkgver-linux-x86_64/usr" "$pkgdir/"
}
