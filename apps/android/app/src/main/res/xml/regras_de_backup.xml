<?xml version="1.0" encoding="utf-8"?>
<!-- Nada vai para o backup na nuvem: a lista de computadores e as impressões digitais ficam só
     neste aparelho (MNF-10). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
