// Pedido de acesso no host (levantamento §5.4) e faixa de sessão ativa (§5.5).
import { CheckBox } from "std-widgets.slint";
import { Tema } from "tema.slint";
import { Botao, Separador } from "componentes.slint";

export component JanelaPedido inherits Window {
    title: @tr("TailDesk: pedido de acesso");
    width: 460px;
    height: 400px;
    always-on-top: true;
    background: Tema.superficie;
    default-font-family: "Inter";

    in property <string> origem: "notebook-yuri";
    in property <string> usuario: "yuri@github";
    in property <string> so: "Fedora 43";
    in property <string> ip: "100.88.20.5";
    in property <bool> primeira-vez: true;
    in-out property <bool> controlar: true;
    in-out property <bool> arquivos: true;
    in-out property <bool> lembrar: false;
    in-out property <int> segundos: 60;

    callback recusar();
    callback permitir();

    // Foco inicial em Recusar: um Enter acidental não libera o acesso.
    init => { recusar-btn.focus(); }

    Timer {
        interval: 1s;
        running: root.segundos > 0;
        triggered => {
            root.segundos -= 1;
            if root.segundos == 0 { root.recusar(); }
        }
    }

    VerticalLayout {
        padding: 24px;
        spacing: 14px;
        Text {
            text: @tr("{} quer acessar este computador", root.origem);
            font-size: 18px;
            font-weight: 700;
            color: Tema.texto;
            wrap: word-wrap;
        }
        Text {
            text: root.usuario + "  ·  " + root.so + "  ·  " + root.ip;
            font-size: Tema.fonte;
            color: Tema.texto-2;
        }
        Separador { }
        Text { text: @tr("O que essa pessoa poderá fazer:"); font-size: Tema.fonte; color: Tema.texto; }
        CheckBox { text: @tr("Ver a tela"); checked: true; enabled: false; }
        CheckBox { text: @tr("Controlar mouse e teclado"); checked <=> root.controlar; }
        CheckBox { text: @tr("Enviar e baixar arquivos"); checked <=> root.arquivos; }
        Separador { }
        CheckBox { text: @tr("Lembrar deste dispositivo (não perguntar de novo)"); checked <=> root.lembrar; }
        if root.primeira-vez: Rectangle {
            border-radius: Tema.raio;
            background: Tema.relay.with-alpha(0.12);
            height: aviso.preferred-height + 16px;
            aviso := Text {
                x: 10px;
                width: parent.width - 20px;
                wrap: word-wrap;
                text: @tr("Nunca aceite um pedido de alguém que ligou dizendo ser do suporte técnico.");
                font-size: Tema.fonte-pequena;
                color: Tema.texto;
            }
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: @tr("Recusa sozinho em {} s", root.segundos);
                font-size: Tema.fonte-pequena;
                color: Tema.texto-2;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            recusar-btn := Botao { texto: @tr("Recusar"); width: 110px; clicado => { root.recusar(); } }
            Botao { texto: @tr("Permitir"); primario: true; width: 110px; clicado => { root.permitir(); } }
        }
    }
}

export component FaixaHost inherits Window {
    title: @tr("TailDesk: sessão ativa");
    width: 760px;
    height: 48px;
    no-frame: true;
    always-on-top: true;
    background: transparent;
    default-font-family: "Inter";

    in property <string> origem: "notebook-yuri";
    in property <bool> arquivos: true;
    // Quais monitores o controlador está vendo (levantamento §5.5).
    in property <string> monitores-vistos: "1 e 2";
    in-out property <bool> pausado: false;
    callback encerrar();

    Rectangle {
        border-radius: 24px;
        background: root.pausado ? #5a6170 : #c93a30;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000050;
        HorizontalLayout {
            padding-left: 18px;
            padding-right: 8px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                vertical-alignment: center;
                color: #ffffff;
                font-size: Tema.fonte;
                font-weight: 600;
                overflow: elide;
                text: root.pausado
                    ? @tr("Controle pausado: {} só vê a tela", root.origem)
                    : root.arquivos ? @tr("{} controla este PC · vendo monitores {} · arquivos ✓", root.origem, root.monitores-vistos)
                    : @tr("{} controla este PC · vendo monitores {}", root.origem, root.monitores-vistos);
            }
            VerticalLayout {
                alignment: center;
                Botao {
                    texto: root.pausado ? @tr("Retomar") : @tr("Pausar controle");
                    altura: 32px;
                    clicado => { root.pausado = !root.pausado; }
                }
            }
            VerticalLayout {
                alignment: center;
                Botao { texto: @tr("Encerrar"); perigo: true; altura: 32px; clicado => { root.encerrar(); } }
            }
        }
    }
}
